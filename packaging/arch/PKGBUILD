# Maintainer: Hysm25 <https://github.com/Hysm25>
pkgname=kreader
pkgver=1.0.0
pkgrel=1
pkgdesc="Modern, local-first EPUB reader with Obsidian-style vault persistence"
arch=('x86_64')
url="https://github.com/Hysm25/KReader"
license=('MIT')
options=('!debug')
depends=(
    'java-runtime>=21'
    'libglvnd'
    'fontconfig'
    'freetype2'
    'libx11'
    'libxext'
    'libxrender'
    'libxcursor'
)
optdepends=(
    'noto-fonts: Default Unicode font coverage'
    'noto-fonts-cjk: Chinese, Japanese, and Korean script support'
    'noto-fonts-arabic: High-quality Arabic and Persian font coverage'
)
source=(
    "kreader.sh"
    "kreader.desktop"
    "kreader.svg"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
)

prepare() {
    # If JARs are staged in $startdir/lib, ensure they are also in $srcdir/lib
    if [ -d "$startdir/lib" ] && [ -n "$(find "$startdir/lib" -name '*.jar' 2>/dev/null | head -n 1)" ]; then
        mkdir -p "$srcdir/lib"
        cp -a "$startdir/lib/"* "$srcdir/lib/"
    fi
}

package() {
    # 1. Install binary launcher script
    install -Dm755 "$srcdir/kreader.sh" "$pkgdir/usr/bin/kreader"

    # 2. Install XDG desktop entry
    install -Dm644 "$srcdir/kreader.desktop" "$pkgdir/usr/share/applications/kreader.desktop"

    # 3. Install scalable application icon
    install -Dm644 "$srcdir/kreader.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kreader.svg"

    # 4. Install application JAR libraries into /usr/lib/kreader/lib
    install -dm755 "$pkgdir/usr/lib/kreader/lib"

    local jar_source=""
    if [ -d "$srcdir/lib" ] && [ -n "$(find "$srcdir/lib" -name '*.jar' 2>/dev/null | head -n 1)" ]; then
        jar_source="$srcdir/lib"
    elif [ -d "$startdir/lib" ] && [ -n "$(find "$startdir/lib" -name '*.jar' 2>/dev/null | head -n 1)" ]; then
        jar_source="$startdir/lib"
    fi

    if [ -z "$jar_source" ]; then
        echo "ERROR: Application JARs not found in $srcdir/lib or $startdir/lib!" >&2
        exit 1
    fi

    echo "==> Installing libraries and native binaries from $jar_source to /usr/lib/kreader/lib/..."
    cp -a "$jar_source/"* "$pkgdir/usr/lib/kreader/lib/"

    local installed_count
    installed_count=$(find "$pkgdir/usr/lib/kreader/lib" -name '*.jar' | wc -l)
    echo "==> Successfully installed $installed_count JAR libraries."
    if [ "$installed_count" -eq 0 ]; then
        echo "ERROR: No JAR libraries were installed into /usr/lib/kreader/lib!" >&2
        exit 1
    fi
}
