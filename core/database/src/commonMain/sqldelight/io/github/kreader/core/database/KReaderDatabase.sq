CREATE TABLE BookEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT,
    description TEXT,
    coverPath TEXT,
    format TEXT NOT NULL,
    sourceData TEXT NOT NULL,
    fileSizeBytes INTEGER NOT NULL DEFAULT 0,
    lastReadTimestamp INTEGER,
    addedTimestamp INTEGER NOT NULL,
    totalProgression REAL NOT NULL DEFAULT 0.0,
    lastLocatorJson TEXT
);

CREATE TABLE BookmarkEntity (
    id TEXT NOT NULL PRIMARY KEY,
    bookId TEXT NOT NULL,
    locatorJson TEXT NOT NULL,
    title TEXT,
    createdTimestamp INTEGER NOT NULL,
    FOREIGN KEY(bookId) REFERENCES BookEntity(id) ON DELETE CASCADE
);

CREATE TABLE HighlightEntity (
    id TEXT NOT NULL PRIMARY KEY,
    bookId TEXT NOT NULL,
    locatorJson TEXT NOT NULL,
    colorHex TEXT NOT NULL,
    annotation TEXT,
    createdTimestamp INTEGER NOT NULL,
    modifiedTimestamp INTEGER NOT NULL,
    FOREIGN KEY(bookId) REFERENCES BookEntity(id) ON DELETE CASCADE
);

-- Queries for BookEntity
selectAllBooks:
SELECT * FROM BookEntity ORDER BY addedTimestamp DESC;

selectBookById:
SELECT * FROM BookEntity WHERE id = :id;

insertOrReplaceBook:
INSERT OR REPLACE INTO BookEntity(
    id, title, author, description, coverPath, format,
    sourceData, fileSizeBytes, lastReadTimestamp, addedTimestamp,
    totalProgression, lastLocatorJson
) VALUES (
    :id, :title, :author, :description, :coverPath, :format,
    :sourceData, :fileSizeBytes, :lastReadTimestamp, :addedTimestamp,
    :totalProgression, :lastLocatorJson
);

updateBookProgress:
UPDATE BookEntity
SET totalProgression = :totalProgression,
    lastLocatorJson = :lastLocatorJson,
    lastReadTimestamp = :lastReadTimestamp
WHERE id = :id;

deleteBook:
DELETE FROM BookEntity WHERE id = :id;

-- Queries for BookmarkEntity
selectBookmarksForBook:
SELECT * FROM BookmarkEntity WHERE bookId = :bookId ORDER BY createdTimestamp DESC;

insertBookmark:
INSERT OR REPLACE INTO BookmarkEntity(id, bookId, locatorJson, title, createdTimestamp)
VALUES (:id, :bookId, :locatorJson, :title, :createdTimestamp);

deleteBookmark:
DELETE FROM BookmarkEntity WHERE id = :id;

-- Queries for HighlightEntity
selectHighlightsForBook:
SELECT * FROM HighlightEntity WHERE bookId = :bookId ORDER BY createdTimestamp ASC;

insertHighlight:
INSERT OR REPLACE INTO HighlightEntity(id, bookId, locatorJson, colorHex, annotation, createdTimestamp, modifiedTimestamp)
VALUES (:id, :bookId, :locatorJson, :colorHex, :annotation, :createdTimestamp, :modifiedTimestamp);

deleteHighlight:
DELETE FROM HighlightEntity WHERE id = :id;

-- Table & Queries for ReaderPreferencesEntity
CREATE TABLE ReaderPreferencesEntity (
    id TEXT NOT NULL PRIMARY KEY,
    preferencesJson TEXT NOT NULL
);

selectPreferences:
SELECT preferencesJson FROM ReaderPreferencesEntity WHERE id = :id;

upsertPreferences:
INSERT OR REPLACE INTO ReaderPreferencesEntity(id, preferencesJson)
VALUES (:id, :preferencesJson);
